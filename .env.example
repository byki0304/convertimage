# Firebase web config (Firebase Console > Project settings > Your apps).
# Copy this file to .env.local for local development and register the same keys
# in Vercel Project > Settings > Environment Variables for deployment.
# If these are empty, the app still runs in Guest mode only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
